# Olivia environment variables — copy to .env and fill in.
# These are read by src/olivia/core/config.py via os.environ.

# Gmail address + app password for the email / WhatsApp skills.
OLIVIA_EMAIL=
OLIVIA_EMAIL_PASSWORD=

# OpenWeatherMap API key for the weather skill (https://openweathermap.org/api).
OPENWEATHER_API_KEY=

# NewsAPI key for the BBC news skill (https://newsapi.org).
NEWS_API_KEY=

# Optional: SAPI5 voice index (0 = male, 1 = female on most Windows setups).
OLIVIA_VOICE_INDEX=1
