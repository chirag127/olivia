# Olivia environment variables — copy to .env and fill in. All optional.
# These are read by src/olivia/core/config.py via os.environ.

# --- Offline speech-to-text (local faster-whisper) ---
# Model size: tiny / base / small / medium / large-v3 (bigger = more accurate, slower).
OLIVIA_WHISPER_MODEL=base
# cpu (offline default) or cuda.
OLIVIA_WHISPER_DEVICE=cpu
# CTranslate2 compute type (int8 = low memory on CPU).
OLIVIA_WHISPER_COMPUTE_TYPE=int8
# Spoken-language hint, e.g. en; leave empty to auto-detect.
OLIVIA_WHISPER_LANGUAGE=en
# Set to 1 to disable all online skills (search/weather/news/translate).
OLIVIA_OFFLINE_ONLY=0

# Gmail address + app password for the email / WhatsApp skills.
OLIVIA_EMAIL=
OLIVIA_EMAIL_PASSWORD=

# OpenWeatherMap API key for the weather skill (https://openweathermap.org/api).
OPENWEATHER_API_KEY=

# NewsAPI key for the BBC news skill (https://newsapi.org).
NEWS_API_KEY=

# Optional: SAPI5 voice index (0 = male, 1 = female on most Windows setups).
OLIVIA_VOICE_INDEX=1
